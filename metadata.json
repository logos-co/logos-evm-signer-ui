{
  "name": "evm_signer_ui",
  "display_name": "Signer",
  "version": "0.1.0",
  "type": "ui_qml",
  "interface": "universal",
  "category": "wallet",
  "description": "The signing approval surface, and where wallets are unlocked: shows what a module asked to sign, in the signer manager's own words, and unlocks each wallet once per session for every app.",
  "main": "evm_signer_ui_plugin",
  "icon": "src/icons/signer.png",
  "view": "qml/SignerView.qml",
  "dependencies": [
    {
      "name": "signer_manager_module",
      "version": "~0.1.0"
    }
  ],
  "optional_dependencies": [
    {
      "name": "token_list_module",
      "version": "~0.1.0"
    },
    "package_manager",
    {
      "name": "qr_scanner_module",
      "version": "~0.1.0"
    }
  ],
  "uses": [
    {
      "intent": "keystore.accounts.unlock"
    }
  ],
  "provides": [
    {
      "intent": "wallets.unlock",
      "params": [
        {
          "name": "seeds",
          "type": "array",
          "required": false,
          "description": "The wallets (the signer manager's seed ids) the app needs unlocked; the first locked one is shown"
        },
        {
          "name": "openHandle",
          "type": "string",
          "required": false,
          "description": "An open the app asked the signer manager for: shown beside its wallet, for the person's consent"
        }
      ]
    },
    {
      "intent": "evm.signing.approve",
      "params": [
        {
          "name": "handle",
          "type": "string",
          "required": true,
          "description": "The signer manager's own name for the approval record to show"
        }
      ]
    }
  ],
  "codegen": {
    "rep": "src/evm_signer_ui.rep"
  },
  "nix": {
    "packages": {
      "build": [],
      "runtime": [
        "qt6.qtdeclarative"
      ]
    },
    "external_libraries": [
      {
        "name": "logos_tx_decoder"
      }
    ],
    "cmake": {
      "find_packages": [],
      "extra_sources": [],
      "extra_include_dirs": [],
      "extra_link_libraries": []
    }
  }
}
