{
  "name": "evm_signer_ui",
  "display_name": "Signer",
  "version": "1.0.0",
  "type": "ui_qml",
  "interface": "universal",
  "category": "wallet",
  "description": "The signing approval surface: shows what a module asked to sign, in the keystore's own words, and takes the vault password.",
  "main": "evm_signer_ui_plugin",
  "icon": "src/icons/signer.png",
  "view": "qml/SignerView.qml",
  "dependencies": [
    "keystore_module"
  ],
  "optional_dependencies": [
    "token_list_module"
  ],
  "provides": [
    {
      "intent": "evm.signing.approve",
      "params": [
        {
          "name": "handle",
          "type": "string",
          "required": true,
          "description": "The keystore's own name for the approval record to show"
        }
      ]
    }
  ],
  "codegen": {
    "rep": "src/evm_signer_ui.rep"
  },
  "nix": {
    "packages": {
      "build": [],
      "runtime": [
        "qt6.qtdeclarative"
      ]
    },
    "external_libraries": [
      {
        "name": "logos_tx_decoder"
      }
    ],
    "cmake": {
      "find_packages": [],
      "extra_sources": [],
      "extra_include_dirs": [],
      "extra_link_libraries": []
    }
  }
}
