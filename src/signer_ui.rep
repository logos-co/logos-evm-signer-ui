// QtRO view contract for the signer UI.
//
// This is the ONE .rep in the wallet stack permitted to carry a password
// parameter. The QML half and this backend are one trust unit — they share a
// plugin identity and one token — so the password crossing between them is not
// a boundary crossing. Every OTHER ui .rep must be free of password parameters,
// and CI asserts that.
//
// What is deliberately absent: any field the backend authors itself for display.
// `renderLines` is whatever the keystore returned, verbatim. The backend may not
// reformat, elide, truncate or re-order it.
class SignerUi
{
    PROP(QString statusText="Starting" READONLY)
    PROP(QString lastError="" READONLY)

    // The queue, as summaries only — never leg detail.
    PROP(QString pendingJson="[]" READONLY)

    // The request currently on screen. Empty when nothing is being shown.
    PROP(QString renderedHandle="" READONLY)
    PROP(QString renderedBundleId="" READONLY)
    PROP(QString renderedRequester="" READONLY)
    PROP(QStringList renderLines READONLY)

    // False until the sheet has been fully visible for the dwell period. Held
    // in C++ so a QML-side edit cannot shorten it.
    PROP(bool dwellElapsed=false READONLY)

    // Re-read the queue from the keystore.
    SLOT(void refresh())
    // Claim a request for display. Demotes whatever was rendered before.
    SLOT(void acknowledge(QString handle))
    // The human said yes. `bundleId` must be the value that was displayed.
    SLOT(bool approve(QString handle, QString bundleId, QString password))
    // The human said no.
    SLOT(bool reject(QString handle))
    // Close the sheet without deciding (the request stays queued).
    SLOT(void dismiss())
}
